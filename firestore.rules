rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFolder() {
      let data = request.resource.data;
      return data.name is string 
          && data.name.size() > 0 
          && data.name.size() <= 100
          && (data.items is list && data.items.size() <= 500);
    }

    // User profiles, preferences, and favorites
    match /users/{userId} {
      // Allow reading user data if owner
      allow read: if isOwner(userId);
      
      // Allow user to update their own document
      allow create, update: if isOwner(userId);

      // Subcollection: Custom NFT Folders
      match /folders/{folderId} {
        // Shared galleries allow public reading of folder content for public share links
        allow read: if true;

        // Only the wallet owner can create, update, or delete folders
        allow create: if isOwner(userId) && isValidFolder();
        allow update: if isOwner(userId) && isValidFolder();
        allow delete: if isOwner(userId);
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
